{
  "$description": "Single source of truth for every colour and design value. Palette is fixed by guidelines/BRAND-THEME.md. Run `node design-tokens/build.js` after editing.",
  "color": {
    "brand": {
      "orange": "#F45803",
      "ice": "#EEF4FF",
      "lime": "#72CF10",
      "blue": "#5C8FF7",
      "white": "#FFFFFF",
      "navy": "#14264C"
    },
    "functional": {
      "error": "#C62828"
    },
    "semantic": {
      "bgPage": { "ref": "brand.ice" },
      "bgSection": { "ref": "brand.ice" },
      "surface": { "ref": "brand.white" },
      "text": { "ref": "brand.navy" },
      "heading": { "ref": "brand.navy" },
      "textSecondary": { "ref": "brand.navy", "alpha": 0.72 },
      "textDisabled": { "ref": "brand.navy", "alpha": 0.48 },
      "actionPrimary": { "ref": "brand.orange" },
      "actionPrimaryText": { "ref": "brand.white" },
      "actionPrimaryOverlay": { "ref": "brand.navy", "alpha": 0.12 },
      "link": { "ref": "brand.navy" },
      "linkUnderline": { "ref": "brand.blue" },
      "interactive": { "ref": "brand.blue" },
      "focus": { "ref": "brand.blue" },
      "navBg": { "ref": "brand.navy" },
      "navText": { "ref": "brand.white" },
      "navTextMuted": { "ref": "brand.white", "alpha": 0.72 },
      "navActive": { "ref": "brand.blue" },
      "navActiveBg": { "ref": "brand.blue", "alpha": 0.18 },
      "success": { "ref": "brand.lime" },
      "successText": { "ref": "brand.navy" },
      "progressFill": { "ref": "brand.lime" },
      "progressTrack": { "ref": "brand.navy", "alpha": 0.08 },
      "error": { "ref": "functional.error" },
      "errorText": { "ref": "functional.error" },
      "textOnError": { "ref": "brand.white" },
      "border": { "ref": "brand.navy", "alpha": 0.16 },
      "inputBorder": { "ref": "brand.navy", "alpha": 0.56 },
      "divider": { "ref": "brand.navy", "alpha": 0.1 },
      "hoverBg": { "ref": "brand.navy", "alpha": 0.04 },
      "selectedBg": { "ref": "brand.blue", "alpha": 0.12 },
      "disabledBg": { "ref": "brand.navy", "alpha": 0.08 },
      "backdrop": { "ref": "brand.navy", "alpha": 0.56 },
      "shadow": { "ref": "brand.navy", "alpha": 0.08 },
      "accentSoft": { "ref": "brand.orange", "alpha": 0.1 },
      "statusApprovedBg": { "ref": "brand.lime" },
      "statusApprovedFg": { "ref": "brand.navy" },
      "statusPendingBg": { "ref": "brand.blue" },
      "statusPendingFg": { "ref": "brand.navy" },
      "statusNeutralBg": { "ref": "brand.ice" },
      "statusNeutralFg": { "ref": "brand.navy" },
      "statusRejectedBg": { "ref": "functional.error" },
      "statusRejectedFg": { "ref": "brand.white" }
    }
  },
  "font": {
    "family": "'Mukta', 'Noto Sans Devanagari', system-ui, sans-serif",
    "familyName": "Mukta",
    "$familyWeb": "Web only. Inter for Latin text, Noto Sans Devanagari for Marathi/Hindi. Mobile keeps the bundled Mukta.",
    "familyWeb": "'Inter', 'Noto Sans Devanagari', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "weightRegular": 400,
    "weightMedium": 500,
    "weightSemibold": 600,
    "weightBold": 700,
    "weightExtrabold": 800
  },
  "text": { "xs": 13, "sm": 14, "base": 16, "md": 19, "lg": 23, "xl": 28, "xxl": 34, "xxxl": 42 },
  "lineHeight": { "body": 1.6, "heading": 1.25 },
  "letterSpacing": { "heading": "-0.02em", "label": "0.04em" },
  "shadow": { "card": "0 1px 2px var(--color-shadow)", "raised": "0 8px 24px var(--color-shadow)" },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
  "radius": { "sm": 6, "md": 10, "lg": 16, "pill": 999 },
  "size": { "tapTarget": 44, "buttonLabelMin": 19, "sidebar": 248, "content": 1120 },
  "contrastPairs": [
    ["text", "surface", 4.5, "body text on cards"],
    ["text", "bgPage", 4.5, "body text on page"],
    ["textSecondary", "surface", 4.5, "secondary text on cards"],
    ["textSecondary", "bgPage", 4.5, "secondary text on page"],
    ["actionPrimaryText", "actionPrimary", 3.0, "primary button label (bold >= 19px only)"],
    ["actionPrimary", "surface", 3.0, "primary button vs card (UI component)"],
    ["actionPrimary", "bgPage", 3.0, "primary button vs page (UI component)"],
    ["navText", "navBg", 4.5, "sidebar text"],
    ["navTextMuted", "navBg", 4.5, "sidebar secondary text"],
    ["navActive", "navBg", 3.0, "sidebar active indicator"],
    ["linkUnderline", "surface", 3.0, "link underline (UI)"],
    ["focus", "surface", 3.0, "focus ring on cards"],
    ["inputBorder", "surface", 3.0, "form field boundary"],
    ["errorText", "surface", 4.5, "error text"],
    ["textOnError", "error", 4.5, "danger button label"],
    ["statusApprovedFg", "statusApprovedBg", 4.5, "approved badge"],
    ["statusPendingFg", "statusPendingBg", 4.5, "pending badge"],
    ["statusNeutralFg", "statusNeutralBg", 4.5, "draft/paused badge"],
    ["statusRejectedFg", "statusRejectedBg", 4.5, "rejected badge"],
    ["successText", "success", 4.5, "text on lime"]
  ]
}
