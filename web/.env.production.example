# Copy to .env.production before `npm run build` ONLY if the API is on another domain.
# Leave unset when Plesk proxies /api on the same domain (the default '/api/v1' is used).
VITE_API_BASE_URL=https://api.example.com/api/v1

# Firebase web app keys (Firebase console > Project settings > Your apps > Web).
# Put real values in .env.local (dev) or .env.production (build). Both are git-ignored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
