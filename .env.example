PORT=
NODE_ENV=
DB_SERVER=
DB_INSTANCE=
DB_PORT=
DB_NAME=
DB_TEST_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_SECRET=
DOWNLOAD_KEY_SECRET=
FILE_SIGNING_SECRET=
WEB_ORIGIN=
# console (dev) | msg91 | smsala (OTP over WhatsApp; needs WHATSAPP_API_TOKEN and WHATSAPP_TPL_OTP below)
OTP_PROVIDER=
# Dev/demo only: every OTP becomes this 6-digit code (e.g. 123456). The API refuses to start with it in production.
OTP_FIXED_CODE=
# TEST SERVERS ONLY: set to true to allow OTP_FIXED_CODE (and OTP_PROVIDER=console) when NODE_ENV=production. Logs a warning on start.
ALLOW_FIXED_OTP_IN_PRODUCTION=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# SMSALA (WhatsApp BSP): token, plus the numeric SMSALA template id of each approved template
WHATSAPP_API_TOKEN=
WHATSAPP_TPL_OTP=
WHATSAPP_TPL_DEMO_SCHEDULED=
WHATSAPP_TPL_LIVE_CLASS=
WHATSAPP_TPL_ENROLLMENT_APPROVED=
WHATSAPP_TPL_SUBSCRIPTION_REMINDER=
# console (dev) | meta | smsala
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional template-name overrides: WHATSAPP_TEMPLATE_DEMO_SCHEDULED, _LIVE_CLASS, _ENROLLMENT_APPROVED, _SUBSCRIPTION_REMINDER
# console (dev) | manual | google
# google + GOOGLE_REFRESH_TOKEN: the token must carry the scopes https://www.googleapis.com/auth/meetings.space.created
# and https://www.googleapis.com/auth/calendar.events, and the Google Meet REST API must be enabled in the Cloud project.
# "Generate link" then makes a Meet space where the teacher (profile email) is co-host and only invited people join without asking.
MEET_PROVIDER=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
GOOGLE_IMPERSONATE_USER=
STORAGE_DIR=
SUPPORT_CONTACT=
POLICY_VERSION=
SEED_ADMIN_MOBILE=
SEED_ADMIN_NAME=
# Push notifications: console (dev, default) | fcm
PUSH_PROVIDER=
# fcm: paste the service-account JSON on one line, OR give a file path. Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Set to false ONLY for local http testing (e.g. http://192.168.x.x). Keep true (default) on https production.
COOKIE_SECURE=true
